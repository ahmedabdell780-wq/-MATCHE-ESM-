rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ===== وظائف مساعدة =====
    function signedIn() { return request.auth != null; }

    function myDoc() {
      return get(/databases/$(db)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && myDoc().role == 'admin';
    }

    function isManager() {
      return signedIn() && myDoc().role == 'manager' && myDoc().status == 'approved';
    }

    function canWrite() {
      return (isAdmin() || isManager()) && myDoc().get('perm', 'full') != 'view_only';
    }

    // ===== حسابات المستخدمين =====
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'manager'
        && request.resource.data.status == 'pending'
        && request.resource.data.teamId is int;
      allow update, delete: if isAdmin();
    }

    // ===== النتائج =====
    // قراءة مفتوحة للجميع (بما فيهم الزوار)
    // الكتابة: المشرف بحرية كاملة، المدير لفريقه فقط ما لم تكن النتيجة معتمدة
    match /scores/{k} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create: if isAdmin()
        || (canWrite()
          && (request.resource.data.home == myDoc().teamId
              || request.resource.data.away == myDoc().teamId)
          && request.resource.data.data.get('status', '') != 'confirmed');
      allow update: if isAdmin()
        || (canWrite()
          && (resource.data.home == myDoc().teamId
              || resource.data.away == myDoc().teamId)
          && request.resource.data.home == resource.data.home
          && request.resource.data.away == resource.data.away
          && resource.data.data.get('status', '') != 'confirmed'
          && (request.resource.data.data.get('status', '') != 'confirmed'
              || resource.data.data.get('enteredBy', -1) != myDoc().teamId));
    }

    // ===== قوائم اللاعبين (Rosters) =====
    match /rosters/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.teamId == myDoc().teamId);
      allow create, update: if isAdmin()
        || (canWrite() && request.resource.data.teamId == myDoc().teamId);
      allow delete: if isAdmin();
    }

    // ===== التشكيلات (Lineups) =====
    match /lineups/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        || (canWrite() && request.resource.data.teamId == myDoc().teamId);
      allow delete: if isAdmin();
    }

    // ===== صور اللاعبين (Photos) =====
    match /photos/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        || (canWrite() && request.resource.data.teamId == myDoc().teamId);
      allow delete: if isAdmin()
        || (canWrite() && resource.data.teamId == myDoc().teamId);
    }

    // ===== الطاقم الفني والإداري (Staff) =====
    match /staff/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        || (canWrite() && request.resource.data.teamId == myDoc().teamId);
      allow delete: if isAdmin()
        || (canWrite() && resource.data.teamId == myDoc().teamId);
    }

    // ===== الإشعارات (Notifications) — إن وُجدت =====
    match /notifications/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

  }
}
