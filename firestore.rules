rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ===== وظائف مساعدة =====
    function signedIn() { return request.auth != null; }

    function myDoc() {
      return get(/databases/$(db)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && myDoc().role == 'admin';
    }

    // مشرف عام كامل (المشرف المساعد: role == 'admin' + adminLevel == 'assist' — بلا تعيين مشرفين ولا حذف حسابات)
    function isSuper() {
      return isAdmin() && myDoc().get('adminLevel', '') != 'assist';
    }

    function isManager() {
      return signedIn() && myDoc().role == 'manager' && myDoc().status == 'approved';
    }

    function canWrite() {
      return (isAdmin() || isManager()) && myDoc().get('perm', 'full') != 'view_only';
    }

    // عضو نادٍ معتمد (ليس زائراً) ينتمي للنادي tid
    function isClubMember(tid) {
      return isManager() && myDoc().get('kind', 'club') != 'visitor' && myDoc().teamId == tid;
    }

    // ===== حساب «مسيّر بطولة الأكابر» (perm == 'entry') =====
    // يُدخل النتائج والمعلومات لمباريات فريقه في بطولة الأكابر فقط، ويدير قائمة لاعبي فريقه
    // وصورهم وطاقمه الفني والإداري (الأكابر حصراً): لا تشكيلات ولا رسائل ولا مراسلة أندية.
    function isEntry() {
      return signedIn() && myDoc().get('perm', 'full') == 'entry';
    }
    // عضو نادٍ كامل الصلاحيات (ليس مسيّر أكابر)
    function isFullMember(tid) {
      return isClubMember(tid) && !isEntry();
    }
    // مسيّر أكابر معتمد: perm == 'entry' + league == 'senior' + حساب معتمد + غير مقيَّد بالمشاهدة
    function isSeniorEntry() {
      return isManager() && isEntry() && myDoc().get('league', '') == 'senior'
        && myDoc().get('kind', 'club') != 'visitor';
    }
    // حسابات league == 'senior' تكتب مفاتيح الأكابر فقط (SENIOR_...)
    function scopeOk(k) {
      return myDoc().get('league', '') != 'senior' || k.matches('SENIOR_.*');
    }

    // ===== حسابات المستخدمين =====
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'manager'
        && request.resource.data.status == 'pending'
        && request.resource.data.teamId is int
        && request.resource.data.keys().hasOnly(['name','phone','teamId','role','kind','status','perm','date']);
      // المشرف العام: كل شيء. المشرف المساعد: يعدّل/يعتمد/يجمّد الحسابات العادية فقط:
      // لا يلمس حساب مشرف، ولا يجعل أحداً مشرفاً، ولا يغيّر adminLevel، ولا يحذف نهائياً.
      allow update: if isSuper()
        || (isAdmin()
            && resource.data.role != 'admin'
            && request.resource.data.role != 'admin'
            && request.resource.data.get('adminLevel', '') == '');
      allow delete: if isSuper();
    }

    // ===== النتائج =====
    // قراءة مفتوحة للجميع (بما فيهم الزوار)
    // الكتابة: المشرف العام بحرية كاملة، أو مسؤول النادي لمباريات فريقه فقط (ذهاباً أو إياباً)
    // موافقة المشرف إلزامية دائماً: لا يمكن لغير المشرف العام اعتماد النتيجة (confirmed)
    // وبعد الاعتماد تُقفل المباراة على النادي: يعدّلها عبر «طلب تعديل» (editRequests) فقط
    match /scores/{k} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create: if isAdmin()
        || (canWrite()
          && scopeOk(k)
          && (request.resource.data.home == myDoc().teamId
              || request.resource.data.away == myDoc().teamId)
          && k == request.resource.data.key.replace('|', '_')
          && int(request.resource.data.key.split(':')[1].split('-')[0]) == request.resource.data.home
          && int(request.resource.data.key.split(':')[1].split('-')[1]) == request.resource.data.away
          && request.resource.data.data.get('status', '') != 'confirmed');
      allow update: if isAdmin()
        || (canWrite()
          && scopeOk(k)
          && (resource.data.home == myDoc().teamId
              || resource.data.away == myDoc().teamId)
          && request.resource.data.home == resource.data.home
          && request.resource.data.away == resource.data.away
          && request.resource.data.key == resource.data.key
          && resource.data.data.get('status', '') != 'confirmed'
          && request.resource.data.data.get('status', '') != 'confirmed');
    }

    // ===== قوائم اللاعبين (Rosters) =====
    match /rosters/{id} {
      allow read: if signedIn() || isAdmin();
      allow create, update: if isAdmin()
        || (canWrite() && !isEntry() && request.resource.data.teamId == myDoc().teamId)
        // مسيّر الأكابر: قائمة «الفريق الأول» لفريقه فقط (الوثيقة <teamId>_SENIOR)
        || (isSeniorEntry()
            && request.resource.data.teamId == myDoc().teamId
            && request.resource.data.cat == 'SENIOR'
            && id == string(myDoc().teamId) + '_SENIOR');
      allow delete: if isAdmin();
    }

    // ===== التشكيلات (Lineups) =====
    // خاصة بالفريق: المشرف + الحسابات المعتمدة لنفس الفريق
    match /lineups/{id} {
      allow read: if isAdmin()
        || (signedIn() && !isEntry() && myDoc().status == 'approved' && myDoc().teamId == resource.data.teamId);
      allow create, update: if isAdmin()
        || (canWrite() && !isEntry() && request.resource.data.teamId == myDoc().teamId);
      allow delete: if isAdmin();
    }

    // ===== صور اللاعبين (Photos) =====
    match /photos/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        || (canWrite() && !isEntry() && request.resource.data.teamId == myDoc().teamId)
        // مسيّر الأكابر: صور فريقه الموسومة league == 'senior' فقط
        || (isSeniorEntry()
            && request.resource.data.teamId == myDoc().teamId
            && request.resource.data.league == 'senior'
            && (resource == null || resource.data.get('league', '') == 'senior'));
      allow delete: if isAdmin()
        || (canWrite() && !isEntry() && resource.data.teamId == myDoc().teamId)
        || (isSeniorEntry()
            && resource.data.teamId == myDoc().teamId
            && resource.data.get('league', '') == 'senior');
    }

    // ===== الطاقم الفني والإداري (Staff) =====
    // خاصة: المشرف + أعضاء النادي المعتمدون لفريقهم فقط (تحوي أرقام هواتف وصوراً)
    match /staff/{id} {
      allow read: if isAdmin() || (signedIn() && isFullMember(resource.data.teamId))
        || (isSeniorEntry() && resource.data.teamId == myDoc().teamId
            && resource.data.league == 'senior');
      allow create, update: if isAdmin()
        || (canWrite() && !isEntry() && request.resource.data.teamId == myDoc().teamId)
        // مسيّر الأكابر: طاقم الأكابر لفريقه فقط (المعرّف sr_<teamId>_… والحقل league == 'senior')
        || (isSeniorEntry()
            && request.resource.data.teamId == myDoc().teamId
            && request.resource.data.league == 'senior'
            && id.matches('sr_' + string(myDoc().teamId) + '_.*')
            && (resource == null || (resource.data.teamId == myDoc().teamId
                && resource.data.get('league', '') == 'senior')));
      allow delete: if isAdmin()
        || (canWrite() && !isEntry() && resource.data.teamId == myDoc().teamId)
        || (isSeniorEntry()
            && resource.data.teamId == myDoc().teamId
            && resource.data.get('league', '') == 'senior'
            && id.matches('sr_.*'));
    }

    // ===== بيانات عامة: البث المباشر، قواعد الإيقاف، حضور الزوار =====
    match /public/{d} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /public/presence {
      allow create, update: if request.resource.data.keys().hasOnly(['lastVisit', 'visitorId', 'team', 'platform']);
    }

    // ===== رموز الإشعارات (القراءة عبر الخادم فقط) =====
    match /pushTokens/{t} {
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.get('follow', []).size() <= 5;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ===== المراسلة: المشرف ↔️ رؤساء النوادي =====
    match /messages/{id} {
      // المشرف يقرأ الكل. مسؤول النادي يقرأ فقط محادثته الفردية (clubUid == uid) ورسائل «النادي ككل» (clubUid == '')
      allow read: if isAdmin()
        || (signedIn() && isFullMember(resource.data.teamId)
            && resource.data.clubUid in ['', request.auth.uid]);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['teamId','from','to','fromUid','fromName','text','img','t','read','clubUid'])
        && request.resource.data.clubUid is string
        && request.resource.data.clubUid.size() <= 128
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.teamId is int
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && (request.resource.data.text.size() > 0 || request.resource.data.get('img', '') != '')
        && request.resource.data.get('img', '') is string
        && request.resource.data.get('img', '').size() < 330000
        && (request.resource.data.get('img', '') == '' || request.resource.data.img.matches('data:image/jpeg;base64,.*'))
        && request.resource.data.read == false
        && ((isAdmin() && request.resource.data.from == 'admin' && request.resource.data.to == 'club')
            || (isFullMember(request.resource.data.teamId) && request.resource.data.from == 'club' && request.resource.data.to == 'admin'
                && request.resource.data.clubUid == request.auth.uid));
      allow update: if signedIn()
        && (
          // وضع علامة «مقروء»
          (((isAdmin() && resource.data.to == 'admin')
              || (isFullMember(resource.data.teamId) && resource.data.to == 'club'
                  && resource.data.clubUid in ['', request.auth.uid]))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
            && request.resource.data.read == true)
          // ترحيل الرسائل القديمة (بلا clubUid) من المشرف مرة واحدة
          || (isAdmin() && !('clubUid' in resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clubUid'])
              && request.resource.data.clubUid is string)
        );
      allow delete: if isAdmin();
    }

    // ===== طلبات تعديل النتائج المعتمدة (تحتاج موافقة المشرف) =====
    // القراءة: المشرف الكل، والنادي طلبات ناديه فقط
    // الإنشاء: عضو النادي (غير المقيَّد بالمشاهدة) لناديه فقط وبحالة pending
    // التعديل: المشرف بحرية (موافقة/رفض)، والنادي لإعادة الإرسال أو الإلغاء فقط
    match /editRequests/{id} {
      allow read: if isAdmin() || (signedIn() && isClubMember(resource.data.teamId));
      allow create: if canWrite()
        && isClubMember(request.resource.data.teamId)
        && request.resource.data.status == 'pending'
        && request.resource.data.by == request.auth.uid;
      allow update: if isAdmin()
        || (canWrite()
            && isClubMember(resource.data.teamId)
            && request.resource.data.teamId == resource.data.teamId
            && request.resource.data.by == request.auth.uid
            && request.resource.data.status in ['pending', 'cancelled']);
      allow delete: if isAdmin();
    }

    // ===== مراسلة الأندية فيما بينها (نص وصور) — يقرأها المشرف ويحذف منها =====
    // الإنشاء: عضو نادٍ معتمد لناديه فقط. التعديل: المستلم يضع read=true لا غير.
    match /clubChats/{id} {
      allow read: if isAdmin()
        || (isManager() && !isEntry() && myDoc().get('kind', 'club') != 'visitor'
            && myDoc().teamId in resource.data.teams);
      allow create: if canWrite()
        && isFullMember(request.resource.data.fromTeam)
        && request.resource.data.keys().hasOnly(['pair','teams','fromTeam','fromUid','fromName','text','img','t','read'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.teams is list
        && request.resource.data.teams.size() == 2
        && request.resource.data.teams[0] is int
        && request.resource.data.teams[1] is int
        && request.resource.data.teams[0] < request.resource.data.teams[1]
        && request.resource.data.fromTeam in request.resource.data.teams
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && (request.resource.data.text.size() > 0 || request.resource.data.get('img', '') != '')
        && request.resource.data.get('img', '') is string
        && request.resource.data.get('img', '').size() < 330000
        && (request.resource.data.get('img', '') == '' || request.resource.data.img.matches('data:image/jpeg;base64,.*'))
        && request.resource.data.read == false
        && request.resource.data.t is int;
      allow update: if isManager() && !isEntry() && myDoc().get('kind', 'club') != 'visitor'
        && myDoc().teamId in resource.data.teams
        && resource.data.fromTeam != myDoc().teamId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow delete: if isAdmin();
    }

    // ===== رسائل الزوار (يكتبها أي زائر دون تسجيل، ويقرأها المشرف فقط) =====
    match /contactMsgs/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name','contact','text','t','read'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 3 && request.resource.data.text.size() <= 800
        && request.resource.data.t is int
        && request.resource.data.read == false;
    }

    // ===== سجل دخول الحسابات (يقرأه المشرف فقط) =====
    match /activity/{uid} {
      allow read: if isAdmin();
      allow create, update: if isManager() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','name','teamId','role','kind','lastLogin','lastSeen','logins'])
        && request.resource.data.uid == uid
        && request.resource.data.name == myDoc().get('name', '')
        && request.resource.data.teamId == myDoc().get('teamId', 0)
        && request.resource.data.logins is int;
      allow delete: if isAdmin();
    }

    // ===== الإشعارات (Notifications) — إن وُجدت =====
    match /notifications/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

  }
}
