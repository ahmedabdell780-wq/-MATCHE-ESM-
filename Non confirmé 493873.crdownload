/* عامل خدمة الإشعارات: يعرض الإشعار الواصل من الخادم حتى والموقع مغلق */
self.addEventListener('install', () => self.skipWaiting());
self.addEventListener('activate', e => e.waitUntil(self.clients.claim()));
self.addEventListener('push', e => {
  let d = {};
  try { d = e.data ? e.data.json() : {}; } catch (x) {}
  const n = Object.assign({}, d.notification, d.data);
  e.waitUntil(self.registration.showNotification(n.title || 'مباريات رابطة تيبازة', {
    body: n.body || '',
    icon: 'favicon.png',
    badge: 'favicon.png',
    dir: 'rtl',
    lang: 'ar',
    tag: n.tag || undefined,
    data: { url: n.url || './' }
  }));
});
self.addEventListener('notificationclick', e => {
  e.notification.close();
  const u = (e.notification.data && e.notification.data.url) || './';
  e.waitUntil(self.clients.matchAll({ type: 'window', includeUncontrolled: true }).then(l => {
    for (const c of l) { if ('focus' in c) return c.focus(); }
    return self.clients.openWindow(u);
  }));
});
